# Copy to supabase/functions/.env for local dev, and set as secrets in production:
#   supabase secrets set --env-file supabase/functions/.env

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reelops-files

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=reelops_checkin_otp
WHATSAPP_TEMPLATE_LANG=en

# Pepper mixed into OTP and download-link hashes
HASH_PEPPER=change-me

# Public URL of the client app (used to build download links)
APP_URL=http://localhost:3000
CRON_SECRET=
