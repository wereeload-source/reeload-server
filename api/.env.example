PORT=4000
# The Next.js app's address. CORS and client download links (CLIENT_URL/d/<token>) use it.
CLIENT_URL=http://localhost:3000

# ── Database: Supabase Postgres ──────────────────────────────────────────────────────────────────
# Supabase dashboard > your project > Connect > "ORMs" / connection strings. Never commit real values.
# The app uses the TRANSACTION pooler (port 6543):
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations (`pnpm db:deploy`) use the SESSION pooler or direct connection (port 5432):
DIRECT_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Recommended in production: Supabase > Project Settings > Database > SSL Configuration > Download certificate.
# Paste the PEM here on one line with \n for line breaks. When set, the database certificate is verified.
DATABASE_CA_CERT=
DB_POOL_MAX=10

# Local development without Supabase: `pnpm db:local` starts a real Postgres and prints this URL.
# DATABASE_URL=postgresql://reeload:reeload@127.0.0.1:54329/reeload

# ── Sign-in ──────────────────────────────────────────────────────────────────────────────────────
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d

# Mixed into check-in code and download-link hashes. Generate like JWT_SECRET (32 bytes). Set once, never change.
HASH_PEPPER=

# ── WhatsApp Business Cloud API (check-in codes) ─────────────────────────────────────────────────
# Leave WHATSAPP_TOKEN empty in development: codes are printed to the API log. Production refuses to run check-in without it.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=reeload_checkin_otp
WHATSAPP_TEMPLATE_LANG=en

# ── Cloudflare R2 (raw and edited files, check-in photos) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET=reeload-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Development only: use the local stand-in (`pnpm storage:local`) instead of R2. Never set in production.
# R2_ENDPOINT=http://127.0.0.1:9100   with R2_ACCESS_KEY_ID=local and R2_SECRET_ACCESS_KEY=local-secret

# Number of proxies in front of the API (e.g. 1 behind the Next.js app or a load balancer), so login limits
# see each person's address. Leave empty only if the API is reached directly by browsers.
TRUST_PROXY=
