PORT=4000
CLIENT_URL=http://localhost:3000

# Neon: use the POOLED connection string (host contains "-pooler"). Put your own here; never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# At least 32 random characters, e.g. `openssl rand -base64 48`. Signs the login tokens.
JWT_SECRET=
# Access tokens are short; the refresh token keeps a reelmaker signed in through a shoot day.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
DB_POOL_MAX=10

# Mixed into OTP and download-link hashes. `openssl rand -base64 32`. Set once, never change.
HASH_PEPPER=

# WhatsApp Business Cloud API (check-in codes). Leave empty in development: codes are printed to the API log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=reelops_checkin_otp
WHATSAPP_TEMPLATE_LANG=en

# Cloudflare R2: a private bucket and an API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_BUCKET=reelops-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Set to 1 (number of proxies) when the API runs behind one, so login throttling sees real client addresses
TRUST_PROXY=
