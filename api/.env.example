PORT=4000
CLIENT_URL=http://localhost:3000

# Neon: use the POOLED connection string (host contains "-pooler"). Put your own here; never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# At least 32 random characters, e.g. `openssl rand -base64 48`. Signs the login tokens.
JWT_SECRET=
# How long a login lasts, in hours.
JWT_TTL_HOURS=24
DB_POOL_MAX=10
